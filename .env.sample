## M3Usort environment variables
## Copy this file to .env and fill in your values.
## Place .env next to your docker-compose.yml.

## Required: used to encrypt credentials stored in config.py.
## Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

## Optional: set your local timezone
TZ=Europe/Amsterdam

## Optional: user/group ID for file permissions
PUID=0
PGID=0

## Optional: used for playlist URL generation
HOST_IP=192.168.1.1
